# Comma-separated list of frontend origins allowed to call this API.
# Use the deployed frontend URL in production, e.g. https://tech-netra.vercel.app
# Defaults to "*" when unset.
ALLOWED_ORIGINS=http://localhost:3000

# Optional: allow Vercel preview URLs, e.g. https://.*\.vercel\.app
# ALLOWED_ORIGIN_REGEX=

# Optional: enables Claude-backed code generation, debugging, and vision audit.
# Without it, the app uses built-in sample fallbacks.
# ANTHROPIC_API_KEY=

# Optional: override the Claude model (defaults to claude-sonnet-5-5).
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: use PostgreSQL instead of the default SQLite file.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Optional: where the git sandbox lives (defaults to backend/workspace).
# TECH_NETRA_WORKSPACE=
